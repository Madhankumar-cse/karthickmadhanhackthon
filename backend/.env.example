# CropGuard AI Pro - Backend Environment Configuration
# PostgreSQL Database URL (Production):
# DATABASE_URL=postgresql://username:password@localhost:5432/cropguard
# Default local fallback uses SQLite: sqlite:///./cropguard.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cropguard

# Path to trained joblib model and metadata
MODEL_PATH=../ml/crop_yield_model.joblib
METADATA_PATH=../ml/crop_yield_metadata.joblib

# Port for FastAPI server
PORT=8000
